# Copy to `.env` (gitignored) and fill in. NEVER commit real values.

# Telegram digest (opt-in, run with `npm run notify`).
# Get a token from @BotFather. If the one you used in chat was exposed,
# revoke it in @BotFather and issue a fresh one.
TELEGRAM_BOT_TOKEN=

# Optional: target chat id. Leave blank to auto-discover from getUpdates
# (you must send /start to the bot at least once first).
TELEGRAM_CHAT_ID=

# 'summary' (default) = id/title/status/risk only — no task notes.
# 'full' = also include task notes (audit/exploit detail!) — private chats only.
TELEGRAM_DETAIL=summary

# ── ChatGPT Browser Integration ─────────────────────────────────────────────
# Enable or disable the ChatGPT Playwright integration.
CHATGPT_ENABLED=true

# Show the browser window (false) or run headless (true).
# Keep false during initial setup and debugging.
CHATGPT_HEADLESS=false

# Path to the persistent Chromium profile directory.
# Defaults to ~/.crtx/browser/chatgpt (platform-appropriate home directory).
# CHATGPT_BROWSER_PROFILE_DIR=

# Timeout (ms) waiting for ChatGPT to finish generating a response.
# Increase for very long prompts.
CHATGPT_RESPONSE_TIMEOUT_MS=120000

# Timeout (ms) for page navigation.
CHATGPT_NAVIGATION_TIMEOUT_MS=30000

# Maximum retries on browser launch failure.
CHATGPT_MAX_BROWSER_RETRIES=3

# Maximum retries on page navigation failure.
CHATGPT_MAX_NAV_RETRIES=3

