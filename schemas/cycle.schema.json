{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "coordinatorId": { "type": "string" },
    "name": { "type": "string" },
    "status": { "enum": ["PENDING", "RUNNING", "COMPLETED", "FAILED"] },
    "tasks": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["id", "coordinatorId", "status"]
}
