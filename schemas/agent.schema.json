{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "provider": { "type": "string" },
    "type": { "type": "string" },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["IDLE", "BUSY", "OFFLINE"] }
  },
  "required": ["id", "provider", "type", "capabilities", "status"]
}
